# ============================================================================
# WFM Platform — PRODUCTION environment template  ★ CANONICAL ★
#
# This is THE production env template for the single-origin deploy/ stack
# (deploy/docker-compose.prod.yml + deploy/DEPLOY_RUNBOOK.md). The older root
# stack (DEPLOYMENT.md + docker-compose.prod.yml + .env.production.example) is
# DEPRECATED — do not use it.
#
# Copy to deploy/prod.env, fill in real values, chmod 600, NEVER commit.
# Every variable below is actually read by the backend code — the source of
# each name is cited so nothing here is guesswork.
#
# Generate secrets with:  openssl rand -hex 64
# NOTE: the backend REFUSES TO BOOT in production if JWT_ACCESS_SECRET or
#       JWT_REFRESH_SECRET is missing, < 32 chars, or still contains the
#       placeholder "change_in_production" (main.ts assertProductionSecrets).
# ============================================================================

# --- Application (main.ts:20,21,26,117) -------------------------------------
NODE_ENV=production
APP_PORT=3000
# Single-origin: the SPA is served from the same domain, so CORS only needs
# the public origin (main.ts:21,49; also read by chat.gateway.ts:11)
CORS_ORIGINS=https://wfm.example.com
# Where the built SPA lives inside the container (main.ts:117-119).
# The Dockerfile bakes it here — do not change unless the image layout changes.
FRONTEND_DIST=/app/frontend/dist

# --- PostgreSQL (app.module.ts:84-88,100-106; migrate.js:46-51) -------------
# Host is the compose SERVICE NAME, not localhost.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wfm_db
POSTGRES_USER=wfm_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
# In-cluster Docker network — no TLS to the DB (app.module.ts:96-102)
POSTGRES_SSL=false
# Only relevant when POSTGRES_SSL=true and the cert is self-signed
POSTGRES_SSL_INSECURE=false
# Connection pool — keep below Postgres max_connections=100 (app.module.ts:106)
DB_POOL_MAX=50

# --- Redis — socket.io chat adapter (redis-io.adapter.ts:24-26) -------------
# Optional: if unreachable, chat falls back to in-memory (single instance only).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# --- JWT (auth.service.ts:225,277,323-328; chat.gateway.ts:32) --------------
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_64
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_64_different
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Auth hardening (users.service.ts:64; auth.service.ts:138-139) ----------
BCRYPT_ROUNDS=12
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=30

# --- Rate limiting, per authenticated user (app.module.ts:118-119) ----------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300

# --- First-admin seed (seed-admin.ts:29-30 — used by npm run seed:admin) ----
# Sets the real password on the placeholder admin created by
# database/migrations/002_seed_boutiqaat.sql. Clear both after seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Demo users seed is refused in production unless this is set (seed-demo-users.ts:29).
# LEAVE UNSET in production.
# ALLOW_DEMO_SEED=

# --- SMTP — outage / notification email (mailer.service.ts:14-42) -----------
# Optional: leave SMTP_HOST empty to disable outbound mail entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- LLM / Advisor guard (llm.service.ts:13-18) ------------------------------
# Optional: Advisor narration. Leave empty to keep the AI layer dormant.
ANTHROPIC_API_KEY=
# LLM_API_KEY=            # alternative key var (checked after ANTHROPIC_API_KEY)
# LLM_MODEL=              # model id override
# LLM_ENDPOINT=           # non-Anthropic endpoint override

# --- Roster / recon (optional path overrides) --------------------------------
# In-memory response cache TTL for heavy roster endpoints (ttl-cache.interceptor.ts:24)
# ROSTER_CACHE_TTL_MS=
#
# Recon source paths (recon.controller.ts:21-25). These are ONLY needed if you
# run the file-based recon endpoints / rebuilds INSIDE the container; the recon
# pipeline normally runs on the box where the month source workbooks live, so
# leave them UNSET here and the DB-backed roster (/ingest → /roster) is used.
# If you do mount the source folders into the container, set these to the paths
# INSIDE the container. Unset = the code's local-dev defaults (a Windows path),
# which do not exist on a Linux server — so the file-based endpoints return a
# clean 400 rather than crashing.
#   RECON_SOURCE_DIR   = folder holding the Odoo/Ameyo/Sprinklr exports
#   RECON_SCHEDULE_FILE= the CC Schedule .xlsx (shift source of truth)
#   RECON_NEW_DIR      = folder the corrected engine reads its monthly sources from
# RECON_SOURCE_DIR=/data/recon/sources
# RECON_SCHEDULE_FILE=/data/recon/CC_Schedule.xlsx
# RECON_NEW_DIR=/data/recon/new/
#
# NOTE: backend/scripts/recon-config.json also holds ABSOLUTE HOST paths under
# "supplementalMatrices" (Director-managed matrix files). Those are read
# literally and skipped gracefully if absent — repoint or remove them when the
# recon pipeline runs on a different machine.

# --- Capacity staffing observability (staffing.service.ts:112) ---------------
# STAFFING_OBSERVER=
