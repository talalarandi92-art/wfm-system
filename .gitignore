# ============================================================
# WFM PLATFORM — .gitignore
# ============================================================

# --- SECRETS — NEVER COMMIT ---
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem
*.key
*.p12
*.pfx

# TLS certificates + ACME state (Let's Encrypt private keys live here)
certbot/

# --- Node.js ---
node_modules/
.pnp/
.pnp.js
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Build outputs ---
dist/
build/
out/
.next/
.nuxt/
.cache/
*.tsbuildinfo

# --- Logs ---
logs/
*.log

# --- Test coverage ---
# Anchored to repo root + build dirs so it never swallows the
# src/modules/coverage source module (Jest output only).
/coverage/
/backend/coverage/
/frontend/coverage/
.nyc_output/

# --- Uploads / user data (never commit real files) ---
uploads/
tmp/

# --- Real workbooks and operational data (never commit) ---
data/samples/*.xlsx
data/samples/*.xls
data/samples/*.xlsm
data/samples/*.csv
!data/samples/.gitkeep
# Also exclude workbooks in docs/ (real schedule files, scorecards)
docs/*.xlsx
docs/*.xls
docs/*.xlsm

# --- Database dumps ---
*.dump
*.sql.bak
*.backup

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- IDEs ---
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~

# --- Docker local volumes (if using named volumes locally) ---
.docker/

# --- TypeORM ---
ormconfig.js
ormconfig.ts

# --- Claude Code local settings (machine-specific paths) ---
# ignore every .claude dir anywhere (incl. nested like frontend/.claude)…
.claude/
# …but keep the ROOT project's portable knowledge skills versioned
!/.claude/
/.claude/*
!/.claude/skills/

# --- Duplicate instruction file artifacts ---
CLAUDE.md.md

# --- Runtime artefacts (local dev servers) ---
*.pid
server.out
server.err
backend/server.out
backend/server.err
frontend/frontend.out
frontend/frontend.err

# Stray skill-upload artifact
nice-upload-root.zip

# Local repo backups (kept outside the repo)
_backups/

# --- Real operational data & PII (kept locally / in "WFM System - DATA", never on GitHub) ---
My work/
DESCKTOP/
OLD LAP/
*.xlsx
*.xls
*.csv
*.pdf
*.bundle
# runtime artefacts
uploads/
*.log

# temp/dev probes & one-off dumps (underscore-prefixed, unreferenced)
backend/scripts/_*
_contra.txt
