# ============================================================
# WFM PLATFORM — .gitignore
# ============================================================

# --- SECRETS — NEVER COMMIT ---
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem
*.key
*.p12
*.pfx

# --- Node.js ---
node_modules/
.pnp/
.pnp.js
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Build outputs ---
dist/
build/
out/
.next/
.nuxt/
.cache/
*.tsbuildinfo

# --- Logs ---
logs/
*.log

# --- Test coverage ---
coverage/
.nyc_output/

# --- Uploads / user data (never commit real files) ---
uploads/
tmp/

# --- Real workbooks and operational data (never commit) ---
data/samples/*.xlsx
data/samples/*.xls
data/samples/*.xlsm
data/samples/*.csv
!data/samples/.gitkeep
# Also exclude workbooks in docs/ (real schedule files, scorecards)
docs/*.xlsx
docs/*.xls
docs/*.xlsm

# --- Database dumps ---
*.dump
*.sql.bak
*.backup

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- IDEs ---
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~

# --- Docker local volumes (if using named volumes locally) ---
.docker/

# --- TypeORM ---
ormconfig.js
ormconfig.ts

# --- Claude Code local settings (machine-specific paths) ---
.claude/

# --- Duplicate instruction file artifacts ---
CLAUDE.md.md
