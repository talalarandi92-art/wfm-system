# ============================================================
# WFM PLATFORM — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# --- Application ---
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
API_PREFIX=api/v1

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wfm_db
POSTGRES_USER=wfm_user
POSTGRES_PASSWORD=                  # REQUIRED — set a strong password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                     # REQUIRED — set a strong password
REDIS_DB=0

# --- JWT (generate strong random secrets — min 64 chars each) ---
JWT_ACCESS_SECRET=                  # REQUIRED
JWT_REFRESH_SECRET=                 # REQUIRED
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Rate Limiting ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=10

# --- File Upload ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=xlsx,xls,csv,pdf,jpg,jpeg,png,mp4,mov

# --- First Tenant (used during initial seed) ---
SEED_TENANT_SLUG=boutiqaat
SEED_ADMIN_EMAIL=                   # REQUIRED for seeding admin account
SEED_ADMIN_PASSWORD=                # REQUIRED — will be hashed before storage

# --- Email (future — leave blank for now) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Security ---
CORS_ORIGINS=http://localhost:5173
BCRYPT_ROUNDS=12
SESSION_SECRET=                     # REQUIRED if using sessions
