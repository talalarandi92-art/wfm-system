# ============================================================
# WFM PLATFORM — PRODUCTION Environment Template
# Copy to ".env" on the server and fill in real values.
# NEVER commit the filled-in .env to git.
#
# Generate strong secrets with:
#   openssl rand -hex 48      (for each JWT/SESSION secret)
#   openssl rand -base64 24   (for DB / Redis passwords)
# ============================================================

# --- Deployment ---
NODE_ENV=production
DOMAIN=wfm.example.com              # REQUIRED — your real domain (no http://, no slash)
APP_PORT=3000
APP_URL=https://wfm.example.com
FRONTEND_URL=https://wfm.example.com
API_PREFIX=api/v1

# --- PostgreSQL (host = docker service name) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wfm_db
POSTGRES_USER=wfm_user
POSTGRES_PASSWORD=                  # REQUIRED — strong password
POSTGRES_SSL=false                  # false for the bundled container; true only for an external/managed DB

# --- Redis (host = docker service name) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                     # REQUIRED — strong password
REDIS_DB=0

# --- JWT (min 64 random chars each — DO NOT reuse the dev secrets) ---
JWT_ACCESS_SECRET=                  # REQUIRED
JWT_REFRESH_SECRET=                 # REQUIRED
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Rate Limiting ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=10

# --- File Upload ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# --- First Tenant (seeded on first DB init only) ---
SEED_TENANT_SLUG=boutiqaat
SEED_ADMIN_EMAIL=                   # REQUIRED
SEED_ADMIN_PASSWORD=                # REQUIRED — change after first login

# --- Security ---
# Must be the HTTPS domain — used for REST CORS and the chat WebSocket origin check.
CORS_ORIGINS=https://wfm.example.com
BCRYPT_ROUNDS=12
SESSION_SECRET=                     # REQUIRED

# --- Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- LLM Advisor (Guard #4) ---
# Set to activate the AI Advisor + future Researcher. Without it they run in
# rule-based fallback mode. Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
